# Environment variables template
# Copy this file to .env and fill in your values

# Database Configuration
MONGO_URI=mongodb://localhost:27017/human_ai_cocreation
ARANGO_URL=http://localhost:8529
ARANGO_USER=root
ARANGO_PASSWORD=password
ARANGO_DATABASE=human_ai_cocreation

# LLM Provider Configuration
LLM_PROVIDER_PREFERENCE=google_genai,groq,huggingface,openai,fallback

# API Keys (optional - only set the ones you plan to use)
HUGGINGFACEHUB_API_TOKEN=your_huggingface_token_here
GOOGLE_API_KEY=your_google_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Human-AI Co-Creation Platform Environment Configuration
# DO NOT COMMIT .env — copy .env.example -> .env and fill real values

# Database Configuration
MONGO_URI=mongodb://root:password@localhost:27017/human_ai_co_create?authSource=admin
ARANGO_URL=http://localhost:8529
ARANGO_USER=root
ARANGO_PASSWORD=changeme_in_production
ARANGO_DATABASE=human_ai_co_create

# Google OAuth Configuration (REQUIRED)
# Get these from Google Cloud Console: https://console.cloud.google.com/
GOOGLE_OAUTH_JSON_PATH=server/config/google_oauth.json
GOOGLE_OAUTH_CLIENT_ID=your_google_client_id_here
GOOGLE_OAUTH_CLIENT_SECRET=your_google_client_secret_here

# JWT & Security Configuration
# Generate with: python -c "import secrets; import base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
JWT_SECRET=your_secure_random_32_byte_base64_secret_here
JWT_ALGORITHM=HS256
JWT_EXPIRE_SECONDS=3600
COOKIE_SECURE=true
COOKIE_SAMESITE=Lax

# Application Configuration
REACT_APP_API_BASE=http://localhost:8000
FRONTEND_URL=http://localhost:3000
DEBUG=true
LOG_LEVEL=INFO

# LLM Provider Configuration (Optional)
# Get API keys from respective providers
OPENAI_API_KEY=your_openai_api_key_here
GOOGLE_API_KEY=your_google_api_key_here
HUGGINGFACEHUB_API_TOKEN=your_huggingface_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Default LLM Configuration
DEFAULT_LLM_MODEL=bigcode/starcoder
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048
LLM_TIMEOUT=30
LLM_RETRY_ATTEMPTS=3
LLM_FALLBACK_ENABLED=true

# Development Environment Markers
NODE_ENV=development
MONGO_ENV=development
ARANGO_ENV=development

# Cookie Configuration
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=true
LOG_LEVEL=INFO

# Frontend Configuration
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# Local LLM Configuration (if using local models)
LOCAL_LLM_URL=http://localhost:5000
LOCAL_LLM_ENABLED=false

# Session Configuration
SESSION_TIMEOUT=3600
MAX_BACKTRACK_DEPTH=2
MAX_BRANCHES=3
IDLE_TIMEOUT=60
SUGGESTION_COOLDOWN=300

# Performance Configuration
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
EMBEDDING_BATCH_SIZE=32
MAX_GRAPH_NODES=1000

# Topic-Agnostic System Configuration
DEFAULT_TOPIC_DOMAIN=story
ENABLE_DOMAIN_DETECTION=true
DOMAIN_CONFIDENCE_THRESHOLD=0.3
PROMPT_AUDIT=false

# Multi-Domain Support
ENABLE_EDUCATION_DOMAIN=true
ENABLE_RESEARCH_DOMAIN=true
ENABLE_PRODUCT_DOMAIN=true
ENABLE_MARKETING_DOMAIN=true
ENABLE_HEALTHCARE_DOMAIN=true
ENABLE_LEGAL_DOMAIN=true
ENABLE_ENGINEERING_DOMAIN=true
ENABLE_DATA_SCIENCE_DOMAIN=true
ENABLE_PRODUCTIVITY_DOMAIN=true
ENABLE_ACCESSIBILITY_DOMAIN=true
ENABLE_TRAINING_DOMAIN=true

# Domain-Specific Validation
STRICT_HEALTHCARE_VALIDATION=true
STRICT_LEGAL_VALIDATION=true
EDUCATION_SAFETY_CHECKS=true
ACCESSIBILITY_COMPLIANCE_CHECKS=true
