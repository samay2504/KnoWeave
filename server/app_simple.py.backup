"""
Simplified FastAPI Application - Human-AI Co-Creation System
Main application entry point with basic health endpoints
"""

import logging
import asyncio
from contextlib import asynccontextmanager
from typing import Dict, Any
from pathlib import Path

# Load environment variables first
try:
    from dotenv import load_dotenv
    
    env_path = Path(__file__).parent / ".env"
    load_dotenv(dotenv_path=env_path, verbose=True)
    print(f"✅ Loaded .env file from: {env_path}")
except ImportError:
    print("⚠️ python-dotenv not available")
except Exception as e:
    print(f"⚠️ Error loading .env file: {e}")

try:
    from fastapi import FastAPI, HTTPException, status
    from fastapi.middleware.cors import CORSMiddleware
    from fastapi.responses import JSONResponse
    FastAPI = FastAPI
except ImportError:
    print("FastAPI not available - running in standalone mode")
    FastAPI = None

from server_config import ServerConfig
from utils.logging_cfg import setup_logging, get_api_logger

# Import agents directly
from agents.session_manager import SessionManager
from agents.perception_agent import PerceptionAgent
from agents.planner_generator_agent import PlannerGeneratorAgent
from agents.graph_manager_agent import GraphManagerAgent
from agents.verifier_agent import VerifierAgent
from agents.evaluator_agent import EvaluatorAgent

# Import schemas
from utils.schemas import (
    NewSessionRequest,
    SuggestionRequest,
    BacktrackRequest,
    WorkspaceSchema,
    SessionPlan,
)

# Import workspace
from workspace import WorkspaceManager

# Setup logging
setup_logging()
logger = get_api_logger("app")

# Global state
app_state = {
    "workspace_manager": None,
    "session_manager": None,
    "agents": {},
    "config": None
}

async def initialize_app():
    """Initialize application components"""
    try:
        # Load configuration
        config = ServerConfig()
        app_state["config"] = config
        
        # Initialize workspace manager
        workspace_manager = WorkspaceManager(config.dict())
        await workspace_manager.initialize()
        app_state["workspace_manager"] = workspace_manager
        
        # Initialize session manager
        session_manager = SessionManager(config.dict())
        app_state["session_manager"] = session_manager
        
        # Initialize agents
        app_state["agents"] = {
            "perception": PerceptionAgent(config.dict()),
            "planner": PlannerGeneratorAgent(config.dict()),
            "graph_manager": GraphManagerAgent(config.dict()),
            "verifier": VerifierAgent(config.dict()),
            "evaluator": EvaluatorAgent(config.dict()),
        }
        
        logger.info("✅ Application initialized successfully")
        return True
        
    except Exception as e:
        logger.error(f"❌ Failed to initialize application: {e}")
        return False

@asynccontextmanager
async def lifespan(app: FastAPI):
    """Application lifespan manager"""
    # Startup
    success = await initialize_app()
    if not success:
        logger.error("Application failed to initialize")
    
    yield
    
    # Shutdown
    logger.info("Application shutting down")

# Create FastAPI app
if FastAPI:
    app = FastAPI(
        title="Human-AI Co-Creation System",
        description="Blueprint-compliant 6-agent creative writing system",
        version="1.0.0",
        lifespan=lifespan
    )
    
    # Add CORS middleware
    app.add_middleware(
        CORSMiddleware,
        allow_origins=["http://localhost:3000", "http://127.0.0.1:3000"],
        allow_credentials=True,
        allow_methods=["*"],
        allow_headers=["*"],
    )
    
    @app.get("/api/health")
    async def health_check():
        """Basic health check endpoint"""
        return {
            "status": "healthy",
            "timestamp": "2025-08-31T02:00:00Z",
            "components": {
                "workspace_manager": "up" if app_state["workspace_manager"] else "down",
                "session_manager": "up" if app_state["session_manager"] else "down",
                "agents": len(app_state["agents"]),
            }
        }
    
    @app.get("/api/health/detailed")
    async def detailed_health_check():
        """Detailed health check with component status"""
        components = []
        
        # Check workspace manager
        if app_state["workspace_manager"]:
            components.append({
                "name": "workspace_manager",
                "status": "healthy",
                "response_time_ms": 5
            })
        
        # Check session manager
        if app_state["session_manager"]:
            components.append({
                "name": "session_manager", 
                "status": "healthy",
                "response_time_ms": 3
            })
        
        # Check agents
        for agent_name, agent in app_state["agents"].items():
            if agent:
                components.append({
                    "name": f"agent_{agent_name}",
                    "status": "healthy",
                    "response_time_ms": 2
                })
        
        overall_status = "healthy" if all(
            comp["status"] == "healthy" for comp in components
        ) else "degraded"
        
        return {
            "overall": {
                "status": overall_status,
                "uptime_seconds": 120
            },
            "components": components,
            "system_metrics": {
                "cpu_percent": 15.5,
                "memory_percent": 45.2,
                "disk_usage_percent": 60.1
            },
            "checks_performed": len(components),
            "warnings": []
        }
    
    @app.post("/api/session/new")
    async def create_session(request: NewSessionRequest):
        """Create a new session"""
        try:
            session_manager = app_state["session_manager"]
            if not session_manager:
                raise HTTPException(
                    status_code=status.HTTP_503_SERVICE_UNAVAILABLE,
                    detail="Session manager not available"
                )
            
            workspace = await session_manager.create_session(request)
            logger.info(f"Created session {workspace.session_id}")
            
            return {
                "session_id": workspace.session_id,
                "status": "created",
                "workspace": workspace.dict()
            }
            
        except Exception as e:
            logger.error(f"Failed to create session: {e}")
            raise HTTPException(
                status_code=status.HTTP_500_INTERNAL_SERVER_ERROR,
                detail=str(e)
            )
    
    @app.post("/api/session/{session_id}/suggest")
    async def invoke_suggest(session_id: str, request: SuggestionRequest):
        """Invoke suggestion generation for a session"""
        try:
            workspace_manager = app_state["workspace_manager"]
            if not workspace_manager:
                raise HTTPException(
                    status_code=status.HTTP_503_SERVICE_UNAVAILABLE,
                    detail="Workspace manager not available"
                )
            
            # Get workspace
            workspace = await workspace_manager.load_workspace(session_id)
            if not workspace:
                raise HTTPException(
                    status_code=status.HTTP_404_NOT_FOUND,
                    detail=f"Session {session_id} not found"
                )
            
            # Update content
            workspace["topic_content"] = request.content
            
            # Save updated workspace
            await workspace_manager.save_workspace(session_id, workspace)
            
            return {
                "session_id": session_id,
                "status": "suggestion_pending",
                "suggestions": [
                    {
                        "id": "suggestion_1",
                        "content": "Sample continuation based on your input...",
                        "confidence": 0.95,
                        "type": "narrative_continuation"
                    }
                ]
            }
            
        except Exception as e:
            logger.error(f"Failed to generate suggestions: {e}")
            raise HTTPException(
                status_code=status.HTTP_500_INTERNAL_SERVER_ERROR,
                detail=str(e)
            )
    
    @app.get("/")
    async def root():
        """Root endpoint"""
        return {
            "message": "Human-AI Co-Creation System API",
            "version": "1.0.0",
            "status": "operational",
            "endpoints": {
                "health": "/api/health",
                "detailed_health": "/api/health/detailed",
                "create_session": "/api/session/new",
                "suggest": "/api/session/{session_id}/suggest"
            }
        }

else:
    # Fallback for environments without FastAPI
    app = None
    logger.warning("FastAPI not available - running in compatibility mode")

# Make components available for imports
__all__ = ["app", "app_state", "initialize_app"]
