      "lines_modified": "194-211, 213-225",
      "changes": [
        "Added environment-aware cookie flag logic in set_auth_cookie()",
        "secure=False for development/localhost, secure=True for production",
        "SameSite=lax for dev, respects config for production",
        "Applied same logic to clear_auth_cookie() for consistency"
